# 2 H100s, 4 ranks via MPS, profiled with NVIDIA Nsight Systems.
# Mirrors profiling_tools/nsys/profile.sh but driven through the runner.

TAG="gpu_2h100_4r_nsys"

NX="${NX:-128}"
NXB="${NXB:-16}"
NUMLEVEL="${NUMLEVEL:-3}"
NLIM="${NLIM:-50}"        # nsys overhead is non-trivial; default to a short run

NUM_GPUS=2
RANKS=4
MEMORY="512G"
WALLTIME="04:00:00"

MODULES="gcc/10.3.0 openmpi/4.1.6-cuda nsight-systems"

PROFILER="nsys"
USE_MPS=1
CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1}"

NSYS_TRACE="cuda,nvtx,mpi"
NSYS_METRIC_DEVICE=0

RECORD_PEAK_MEM_CPU=0
RECORD_PEAK_MEM_GPU=1

MPIRUN_EXTRA="--map-by ppr:4:node:pe=1"
