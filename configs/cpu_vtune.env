# 16-core SPR CPU + Intel vTune (default: hotspots).

TAG="cpu16_vtune"

NX="${NX:-128}"
NXB="${NXB:-16}"
NUMLEVEL="${NUMLEVEL:-3}"
NLIM="${NLIM:-250}"

RANKS=16
MEMORY="64G"
WALLTIME="04:00:00"

# Lighthouse: vtune lives in its own module
MODULES="nvhpc-openmpi4 vtune"

PROFILER="vtune"
VTUNE_COLLECT="hotspots"   # also useful: memory-access, threading, hpc-performance

RECORD_PEAK_MEM_CPU=1
RECORD_PEAK_MEM_GPU=0

CPU_BIND="--bind-to core --map-by core"
