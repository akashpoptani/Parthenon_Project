# configs/common.env
# Defaults that every other config inherits. Sourced before the per-run config
# by the run_*_template.sh scripts. Keep this file free of run-specific knobs
# (NX, NXB, RANKS, ...) -- those belong in the per-run configs.

# ---- Paths ------------------------------------------------------------------
# All relative to the repository root. Override per-config if you build
# Parthenon outside the repo.
PARTHENON_DIR="${PARTHENON_DIR:-$SCRIPT_DIR/parthenon}"
BUILD_DIR_CPU="${BUILD_DIR_CPU:-$PARTHENON_DIR/build_cpu}"
BUILD_DIR_GPU="${BUILD_DIR_GPU:-$PARTHENON_DIR/build_gpu}"
BENCHMARK_PIN="${BENCHMARK_PIN:-$PARTHENON_DIR/benchmarks/burgers/burgers.pin}"

# kokkos-tools install location (used by kokkos_kt / kokkos_mem configs)
KOKKOS_TOOLS_INSTALL="${KOKKOS_TOOLS_INSTALL:-$SCRIPT_DIR/kokkos-tools/install}"

# ---- Output -----------------------------------------------------------------
OUTPUT_DIR="${OUTPUT_DIR:-$SCRIPT_DIR/results}"

# ---- Lighthouse defaults (override per-cluster as needed) -------------------
# We don't actually allocate from here; this is informational metadata only,
# echoed into meta.txt.
WALLTIME="${WALLTIME:-04:00:00}"
MEMORY="${MEMORY:-256G}"

# ---- Sampling ---------------------------------------------------------------
RECORD_PEAK_MEM_CPU="${RECORD_PEAK_MEM_CPU:-1}"
MEM_SAMPLE_INTERVAL="${MEM_SAMPLE_INTERVAL:-1}"
RECORD_PEAK_MEM_GPU="${RECORD_PEAK_MEM_GPU:-1}"
GPU_MEM_SAMPLE_MS="${GPU_MEM_SAMPLE_MS:-100}"

# ---- Tools ------------------------------------------------------------------
TIME_BIN="${TIME_BIN:-/usr/bin/time}"
