# 1 H100, 1 MPI rank baseline.

TAG="gpu_1h100"

NX="${NX:-128}"
NXB="${NXB:-16}"
NUMLEVEL="${NUMLEVEL:-3}"
NLIM="${NLIM:-250}"

NUM_GPUS=1
RANKS=1
MEMORY="256G"
WALLTIME="02:00:00"

MODULES="gcc/10.3.0 openmpi/4.1.6-cuda"

PROFILER="none"
USE_MPS=0
CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"

RECORD_PEAK_MEM_CPU=0
RECORD_PEAK_MEM_GPU=1

# 1 rank pinned to one GPU + one core; cluster-specific tweak as needed.
MPIRUN_EXTRA="--map-by ppr:1:node:pe=1"
