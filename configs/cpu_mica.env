# 16-core SPR CPU + Intel Pin / MICA opcode-mix analysis.
# Required: PIN_ROOT must point to the extracted Pin tree containing
# MICA/obj-intel64/mica.so (see profiling_tools/pin/README.md).

TAG="cpu16_mica"

NX="${NX:-128}"
NXB="${NXB:-16}"
NUMLEVEL="${NUMLEVEL:-3}"
NLIM="${NLIM:-50}"        # MICA adds 5-10x overhead; shrink the run by default

RANKS=16
MEMORY="128G"
WALLTIME="08:00:00"

MODULES="nvhpc-openmpi4"

PROFILER="mica"
PIN_ROOT="${PIN_ROOT:-$HOME/pin}"
MICA_CONF="$SCRIPT_DIR/profiling_tools/pin/mica.conf"

RECORD_PEAK_MEM_CPU=1
RECORD_PEAK_MEM_GPU=0

CPU_BIND="--bind-to core --map-by core"
