# 16-core SPR CPU + kokkos-tools memory tool.
# Default points at libkp_memory_events.so (allocation/deallocation timeline).
# Switch to libkp_hwm.so to record only the high-water mark.

TAG="cpu16_kmem"

NX="${NX:-128}"
NXB="${NXB:-16}"
NUMLEVEL="${NUMLEVEL:-3}"
NLIM="${NLIM:-250}"

RANKS=16
MEMORY="64G"
WALLTIME="02:00:00"

MODULES="nvhpc-openmpi4"

PROFILER="kokkos_mem"
KOKKOS_TOOLS_LIB="$KOKKOS_TOOLS_INSTALL/lib64/libkp_memory_events.so"
# alternative: KOKKOS_TOOLS_LIB="$KOKKOS_TOOLS_INSTALL/lib64/libkp_hwm.so"

RECORD_PEAK_MEM_CPU=1
RECORD_PEAK_MEM_GPU=0

CPU_BIND="--bind-to core --map-by core"
