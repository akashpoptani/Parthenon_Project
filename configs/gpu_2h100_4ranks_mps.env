# 2 H100s with 2 ranks per GPU = 4 total ranks, scheduled via MPS.

TAG="gpu_2h100_4r_mps"

NX="${NX:-128}"
NXB="${NXB:-16}"
NUMLEVEL="${NUMLEVEL:-3}"
NLIM="${NLIM:-250}"

NUM_GPUS=2
RANKS=4
MEMORY="512G"
WALLTIME="02:00:00"

MODULES="gcc/10.3.0 openmpi/4.1.6-cuda"

PROFILER="none"
USE_MPS=1                 # auto would also pick 1 since RANKS > NUM_GPUS
CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1}"

RECORD_PEAK_MEM_CPU=0
RECORD_PEAK_MEM_GPU=1

MPIRUN_EXTRA="--map-by ppr:4:node:pe=1"
