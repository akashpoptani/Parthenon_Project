# 2 H100s, 4 ranks via MPS, instrumented with kokkos-tools memory tool.

TAG="gpu_2h100_4r_kmem"

NX="${NX:-128}"
NXB="${NXB:-16}"
NUMLEVEL="${NUMLEVEL:-3}"
NLIM="${NLIM:-250}"

NUM_GPUS=2
RANKS=4
MEMORY="512G"
WALLTIME="02:00:00"

MODULES="gcc/10.3.0 openmpi/4.1.6-cuda"

PROFILER="kokkos_mem"
USE_MPS=1
CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1}"

# memory-events captures alloc/free timeline; switch to libkp_hwm.so for HWM only.
KOKKOS_TOOLS_LIB="$KOKKOS_TOOLS_INSTALL/lib64/libkp_memory_events.so"

RECORD_PEAK_MEM_CPU=0
RECORD_PEAK_MEM_GPU=1

MPIRUN_EXTRA="--map-by ppr:4:node:pe=1"
