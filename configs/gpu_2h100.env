# 2 H100s, 2 MPI ranks (1 rank per GPU) -- baseline 2-GPU run.

TAG="gpu_2h100"

NX="${NX:-128}"
NXB="${NXB:-16}"
NUMLEVEL="${NUMLEVEL:-3}"
NLIM="${NLIM:-250}"

NUM_GPUS=2
RANKS=2
MEMORY="512G"
WALLTIME="02:00:00"

MODULES="gcc/10.3.0 openmpi/4.1.6-cuda"

PROFILER="none"
USE_MPS=0
CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1}"

RECORD_PEAK_MEM_CPU=0
RECORD_PEAK_MEM_GPU=1

MPIRUN_EXTRA="--map-by ppr:2:node:pe=1"
