# 16-core SPR CPU baseline -- plain run (no profiler).

TAG="cpu16_baseline"

# Mesh-related parameters (overridden by experiment scripts when needed)
NX="${NX:-128}"
NXB="${NXB:-16}"
NUMLEVEL="${NUMLEVEL:-3}"
NLIM="${NLIM:-250}"

# Resources
RANKS=16
MEMORY="64G"
WALLTIME="01:00:00"

# Lighthouse / SPR module set
MODULES="nvhpc-openmpi4"

# Profiler
PROFILER="none"

# Memory tracking: CPU only on a CPU-only node
RECORD_PEAK_MEM_CPU=1
RECORD_PEAK_MEM_GPU=0

# Optional: pin one rank per physical core
CPU_BIND="--bind-to core --map-by core"
