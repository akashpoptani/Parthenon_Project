# 2 H100s, 4 ranks via MPS, profiled with NVIDIA Nsight Compute.
# Note: NCU MPS support is in NCU 2025.2+. With older NCU you must keep
# RANKS == NUM_GPUS (1 rank per GPU) and set USE_MPS=0.

TAG="gpu_2h100_4r_ncu"

NX="${NX:-128}"
NXB="${NXB:-16}"
NUMLEVEL="${NUMLEVEL:-3}"
NLIM="${NLIM:-1}"         # NCU is *very* expensive; profile a single cycle

NUM_GPUS=2
RANKS=4
MEMORY="512G"
WALLTIME="08:00:00"

MODULES="gcc/10.3.0 openmpi/4.1.6-cuda nsight-compute"

PROFILER="ncu"
USE_MPS=1
CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1}"

# Default metric set lifted from profiling_tools/ncu/profile.sh
NCU_METRICS="sm__sass_thread_inst_executed_op_fp16_pred_on,sm__sass_thread_inst_executed_op_fp32_pred_on,sm__sass_thread_inst_executed_op_fp64_pred_on,sm__sass_thread_inst_executed_op_fp8_pred_on,sm__throughput.avg.pct_of_peak_sustained_active,sm__warps_active.avg.pct_of_peak_sustained_active,dram__bytes,smsp__thread_inst_executed_per_inst_executed.ratio"
NCU_ROI_PROFILE=0

RECORD_PEAK_MEM_CPU=0
RECORD_PEAK_MEM_GPU=1

MPIRUN_EXTRA="--map-by ppr:4:node:pe=1"
