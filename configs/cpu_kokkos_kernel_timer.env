# 16-core SPR CPU + kokkos-tools simple-kernel-timer.
# After the run the .dat file lives in the run directory; analyse with:
#   $KOKKOS_TOOLS_INSTALL/bin/kp_reader run.dat

TAG="cpu16_kkt"

NX="${NX:-128}"
NXB="${NXB:-16}"
NUMLEVEL="${NUMLEVEL:-3}"
NLIM="${NLIM:-250}"

RANKS=16
MEMORY="64G"
WALLTIME="02:00:00"

MODULES="nvhpc-openmpi4"

PROFILER="kokkos_kt"
KOKKOS_TOOLS_LIB="$KOKKOS_TOOLS_INSTALL/lib64/libkp_kernel_timer.so"

RECORD_PEAK_MEM_CPU=1
RECORD_PEAK_MEM_GPU=0

CPU_BIND="--bind-to core --map-by core"
